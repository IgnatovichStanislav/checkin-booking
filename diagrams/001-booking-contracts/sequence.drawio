<mxfile host="app.diagrams.net">
  <diagram id="accepted-change" name="DB-first intake and later runtime acknowledgments">
    <mxGraphModel page="1" pageWidth="1350" pageHeight="1050" grid="1" gridSize="10"><root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="legend-same" value="Unchanged" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="132" height="30" as="geometry"/></mxCell>
        <mxCell id="legend-added" value="Added" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="174" y="18" width="132" height="30" as="geometry"/></mxCell>
        <mxCell id="legend-changed" value="(changed)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="318" y="18" width="132" height="30" as="geometry"/></mxCell>
        <mxCell id="legend-removed" value="(removed)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="462" y="18" width="132" height="30" as="geometry"/></mxCell>
        <mxCell id="legend-open" value="Open question" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="606" y="18" width="132" height="30" as="geometry"/></mxCell>
        <mxCell id="actor-0" value="Salou PMS" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="270" height="45" as="geometry"/></mxCell>
        <mxCell id="actor-1" value="Scoped intake / PostgreSQL" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="270" height="45" as="geometry"/></mxCell>
        <mxCell id="actor-2" value="Outbox publisher / Kafka" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="650" y="80" width="270" height="45" as="geometry"/></mxCell>
        <mxCell id="actor-3" value="Consumer / PostgreSQL" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="270" height="45" as="geometry"/></mxCell>
        <mxCell id="import" value="POST or PUT full snapshot" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="commit" value="Validate and lock scoped identity. Commit booking, restricted snapshot and outbox together (changed)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="http" value="HTTP success + mappings only after commit" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="30" y="285" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="publish" value="Publish opaque eventId + snapshotId using scoped source key" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="650" y="285" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="confirm" value="Broker confirms publication. Publisher marks sent. Crash may repeat event." style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="650" y="400" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="consume" value="Load exact scoped snapshot. Deduplicate effect, then commit worker transaction." style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="465" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="offset" value="Advance contiguous partition offset only after worker DB commit." style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="600" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="retry" value="Processing failure: bounded retry. On terminal failure hand off dead letter durably." style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="650" y="735" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="ack" value="After durable dead letter, advance only past completed work." style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="735" width="270" height="75" as="geometry"/></mxCell>
        <mxCell id="import-commit" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="import" target="commit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="commit-http" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="commit" target="http"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="commit-publish" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="commit" target="publish"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="publish-confirm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="publish" target="confirm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="confirm-consume" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="confirm" target="consume"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="consume-offset" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="consume" target="offset"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="consume-retry" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="consume" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="retry-ack" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="retry" target="ack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="scope" value="001 specifies these boundaries. HTTP, PostgreSQL and Kafka execution belong to later runtime features." style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="895" width="1200" height="48" as="geometry"/></mxCell>
