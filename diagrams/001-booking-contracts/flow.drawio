        <mxCell id="edge-0" edge="1" parent="1" source="hotels" target="receive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;">
