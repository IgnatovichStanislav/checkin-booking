<mxfile host="app.diagrams.net">
  <diagram id="data" name="ER: verification evidence records">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1280" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="notation" value="ER diagram of the implemented verification files and their relationships.&#10;Green = added; amber = changed; white = existing. V01–V05 source/evidence boundaries; V07–V08 eval/review boundaries." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="15" width="1220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="run" value="Run manifest (added)&#10;PK runId&#10;source: commit / dirty / scopeVersion / digest&#10;phase outcomes / timestamps / safe codes&#10;aggregate result / relative evidence paths" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="115" width="400" height="145" as="geometry" />
        </mxCell>
        <mxCell id="build" value="Build and policy attestations (added)&#10;Optional buildAttestation: source and artifact digests&#10;Optional attachmentPolicy: artifact digest,&#10;policy verdict and module hashes" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="340" width="330" height="115" as="geometry" />
        </mxCell>
        <mxCell id="receipt" value="Execution receipt (added)&#10;runId / sourceDigest / joinedRunId&#10;Nullable platformExitCode; test/evidence outcomes&#10;sourceVerified / policyVerified / verificationEligible&#10;Safe failure code" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="440" y="340" width="390" height="135" as="geometry" />
        </mxCell>
        <mxCell id="inventory" value="Required identity inventory (added)&#10;PK expected assembly/class/method&#10;Reviewed exact required method set&#10;No scenario/fixture duplication" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="900" y="115" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="results" value="Safe method outcomes (changed)&#10;Known method identity; joinedRunId links local results&#10;Scenario/path IDs, proof level and fixture references&#10;Terminal state and counts; safe XML stays local" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="880" y="550" width="360" height="145" as="geometry" />
        </mxCell>
        <mxCell id="export" value="Current-run JSON export (added)&#10;run.json; execution.json if accepted&#10;scenario-map.json and scenario-results.json&#10;when evidence validation passes&#10;Records bind to runId and the available source digest" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="700" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="eval" value="Existing behavioral eval record&#10;case/source baseline/prompt/trace/grade/limits&#10;Private ignored trace; no model/session&#10;attribution in public summary" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="440" y="700" width="390" height="130" as="geometry" />
        </mxCell>
        <mxCell id="privacy" value="Privacy and source boundary&#10;The policy checks owned PE metadata before loading the test executable. The full check discards child stdout and stderr.&#10;Standalone evidence has sourceVerified, policyVerified and verificationEligible set to false." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="870" width="1220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="run-build" value="1 run : 0..1 of each attestation" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;html=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="run" target="build">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="run-receipt" value="1 run : 0..1 receipt" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;html=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="run" target="receipt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="receipt-outcomes" value="1 receipt : 0..n method outcomes" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.8;entryX=0;entryY=0.38;endArrow=none;html=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="receipt" target="results">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="855" y="448" />
              <mxPoint x="855" y="605" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="inventory-outcomes" value="1 required identity : 0..n outcomes across runs" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;html=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="inventory" target="results">
          <mxGeometry x="-0.4" relative="1" as="geometry">
            <mxPoint x="0" y="-18" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="run-export" value="1 run : 0..1 export" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.9;entryX=0.487;entryY=0;endArrow=none;html=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="run" target="export">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="385" y="275" />
              <mxPoint x="385" y="655" />
              <mxPoint x="205" y="655" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="outcomes-export" value="0..n valid outcomes : 0..1 run export" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;exitX=0;exitY=0.93;entryX=1;entryY=0.5;html=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="results" target="export">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="840" y="685" />
              <mxPoint x="425" y="685" />
              <mxPoint x="425" y="765" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
