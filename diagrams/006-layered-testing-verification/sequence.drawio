<mxfile host="app.diagrams.net">
  <diagram id="sequence" name="Verification sequence">
    <mxGraphModel dx="1250" dy="900" grid="1" gridSize="10" page="1" pageWidth="1280" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="legend" value="Legend: white = existing; green = added; amber = changed.&#10;Red dashed = removed (none); purple = open questions (none). No booking transaction/ack flow changes." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
