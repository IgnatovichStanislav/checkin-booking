{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CHECKIN feature 001 contracts",
  "$defs": {
    "Passport": {
      "type": "object",
      "properties": {
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "issuingCountry": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "expiresOn": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "number",
        "issuingCountry",
        "expiresOn"
      ],
      "additionalProperties": false
    },
    "Guest": {
      "type": "object",
      "properties": {
        "srcGuestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "lastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date"
        },
        "passport": {
          "anyOf": [
            {
              "$ref": "#/$defs/Passport"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "srcGuestId",
        "firstName",
        "lastName",
        "dateOfBirth",
        "passport"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "srcBookingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
        },
        "arrivalDate": {
          "type": "string",
          "format": "date"
        },
        "departureDate": {
          "type": "string",
          "format": "date"
        },
        "reservationStatus": {
          "enum": [
            "confirmed",
            "cancelled"
          ]
        },
        "cancelledAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "guests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Guest"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "srcBookingId",
        "createdAt",
        "updatedAt",
        "arrivalDate",
        "departureDate",
        "reservationStatus",
        "guests"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "reservationStatus": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "required": [
              "cancelledAt"
            ],
            "properties": {
              "cancelledAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
              }
            }
          },
          "else": {
            "properties": {
              "cancelledAt": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Mappings": {
      "type": "object",
      "properties": {
        "bookingId": {
          "type": "string",
          "format": "uuid"
        },
        "srcBookingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "guests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "guestId": {
                "type": "string",
                "format": "uuid"
              },
              "srcGuestId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "guestId",
              "srcGuestId"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "bookingId",
        "srcBookingId",
        "guests"
      ],
      "additionalProperties": false
    },
    "Attendance": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "arrived",
            "checkedIn",
            "checkedOut",
            "noShow"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
        }
      },
      "required": [
        "status",
        "occurredAt"
      ],
      "additionalProperties": false
    },
    "Correction": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "expected",
            "arrived",
            "checkedIn",
            "checkedOut",
            "noShow"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
        },
        "reasonCode": {
          "enum": [
            "incorrect_report",
            "incorrect_status",
            "incorrect_time"
          ]
        }
      },
      "required": [
        "status",
        "occurredAt",
        "reasonCode"
      ],
      "additionalProperties": false
    },
    "AttendanceReceipt": {
      "type": "object",
      "properties": {
        "attendanceEventId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "attendanceEventId"
      ],
      "additionalProperties": false
    },
    "Status": {
      "type": "object",
      "properties": {
        "bookingId": {
          "type": "string",
          "format": "uuid"
        },
        "srcBookingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reservationStatus": {
          "enum": [
            "confirmed",
            "cancelled"
          ]
        },
        "activeGuestSummary": {
          "anyOf": [
            {
              "enum": [
                "processing",
                "actionRequired",
                "completed",
                "failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "guests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "guestId": {
                "type": "string",
                "format": "uuid"
              },
              "srcGuestId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "participation": {
                "enum": [
                  "active",
                  "cancelled"
                ]
              },
              "attendance": {
                "enum": [
                  "expected",
                  "arrived",
                  "checkedIn",
                  "checkedOut",
                  "noShow"
                ]
              },
              "operationId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "registrationStatus": {
                "anyOf": [
                  {
                    "enum": [
                      "processing",
                      "actionRequired",
                      "completed",
                      "failed"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reasonCode": {
                "anyOf": [
                  {
                    "enum": [
                      "missing_passport",
                      "passport_expired",
                      "correct_data",
                      "intervention_required",
                      "identity_expired"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "guestId",
              "srcGuestId",
              "participation",
              "attendance",
              "operationId",
              "registrationStatus",
              "reasonCode"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "operationId": {
                    "type": "null"
                  },
                  "registrationStatus": {
                    "type": "null"
                  },
                  "reasonCode": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "operationId": {
                    "type": "string"
                  },
                  "registrationStatus": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "outstandingCancellations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "guestId": {
                "type": "string",
                "format": "uuid"
              },
              "operationId": {
                "type": "string",
                "format": "uuid"
              },
              "registrationStatus": {
                "enum": [
                  "processing",
                  "actionRequired",
                  "failed"
                ]
              },
              "reasonCode": {
                "anyOf": [
                  {
                    "enum": [
                      "missing_passport",
                      "passport_expired",
                      "correct_data",
                      "intervention_required",
                      "identity_expired"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "guestId",
              "operationId",
              "registrationStatus",
              "reasonCode"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "bookingId",
        "srcBookingId",
        "reservationStatus",
        "activeGuestSummary",
        "guests",
        "outstandingCancellations"
      ],
      "additionalProperties": false
    },
    "Notification": {
      "type": "object",
      "properties": {
        "notificationId": {
          "type": "string",
          "format": "uuid"
        },
        "bookingId": {
          "type": "string",
          "format": "uuid"
        },
        "guestId": {
          "type": "string",
          "format": "uuid"
        },
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "registrationStatus": {
          "enum": [
            "processing",
            "actionRequired",
            "completed",
            "failed",
            null
          ]
        },
        "reasonCode": {
          "anyOf": [
            {
              "enum": [
                "missing_passport",
                "passport_expired",
                "correct_data",
                "intervention_required",
                "identity_expired",
                "registration_stopped"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
        }
      },
      "required": [
        "notificationId",
        "bookingId",
        "guestId",
        "operationId",
        "registrationStatus",
        "reasonCode",
        "occurredAt"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "registrationStatus": {
              "type": "null"
            },
            "reasonCode": {
              "const": "registration_stopped"
            }
          }
        },
        {
          "properties": {
            "registrationStatus": {
              "type": "string"
            },
            "reasonCode": {
              "not": {
                "const": "registration_stopped"
              }
            }
          }
        }
      ],
      "description": "A stopped unsent operation carries its historical operationId and registration_stopped reason."
    },
    "SubscriptionInput": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "enabled": {
          "type": "boolean"
        },
        "eventStates": {
          "type": "array",
          "items": {
            "enum": [
              "processing",
              "actionRequired",
              "completed",
              "failed",
              null
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "endpoint",
        "enabled",
        "eventStates"
      ],
      "additionalProperties": false
    },
    "Subscription": {
      "type": "object",
      "properties": {
        "subscriptionId": {
          "type": "string",
          "format": "uuid"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "enabled": {
          "type": "boolean"
        },
        "eventStates": {
          "type": "array",
          "items": {
            "enum": [
              "processing",
              "actionRequired",
              "completed",
              "failed",
              null
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "activeKeyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "subscriptionId",
        "endpoint",
        "enabled",
        "eventStates",
        "activeKeyId"
      ],
      "additionalProperties": false
    },
    "Rotation": {
      "type": "object",
      "properties": {
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "keyId"
      ],
      "additionalProperties": false
    },
    "Delivery": {
      "type": "object",
      "properties": {
        "deliveryId": {
          "type": "string",
          "format": "uuid"
        },
        "notificationId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "pending",
            "delivered",
            "failed"
          ]
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "occurredAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
              },
              "outcome": {
                "enum": [
                  "delivered",
                  "temporary_failure",
                  "permanent_failure",
                  "uncertain"
                ]
              }
            },
            "required": [
              "attempt",
              "occurredAt",
              "outcome"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "deliveryId",
        "notificationId",
        "state",
        "attempts"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "unauthenticated",
            "forbidden",
            "not_found",
            "invalid_snapshot",
            "invalid_request",
            "body_too_large",
            "use_put",
            "snapshot_conflict",
            "attendance_conflict",
            "temporarily_unavailable",
            "identity_erased"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "path",
              "code"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "code",
        "fields"
      ],
      "additionalProperties": false
    },
    "BookingEvent": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "bookingId": {
          "type": "string",
          "format": "uuid"
        },
        "snapshotId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "eventId",
        "bookingId",
        "snapshotId"
      ],
      "additionalProperties": false
    },
    "ExistingImportConflict": {
      "type": "object",
      "properties": {
        "code": {
          "const": "use_put"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "path",
              "code"
            ],
            "additionalProperties": false
          }
        },
        "updatePath": {
          "type": "string",
          "pattern": "^/api/v1/bookings/[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
        }
      },
      "required": [
        "code",
        "fields",
        "updatePath"
      ],
      "additionalProperties": false
    }
  }
}
