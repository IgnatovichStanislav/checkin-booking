    "/api/v1/bookings": {
      "post": {
        "operationId": "importBooking",
        "responses": {
          "200": {
            "description": "Identical accepted snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.schema.json#/$defs/Mappings"
                }
              }
            }
          },
          "201": {
            "description": "Committed new booking",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.schema.json#/$defs/Mappings"
                }
              }
            },
            "headers": {
              "Location": {
                "required": true,
                "description": "Owned update URL",
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body or immutable source field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient action permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.schema.json#/$defs/Error"
                }
              }
            }
          },
          "409": {
            "description": "Different existing snapshot. Return the owned updatePath, including for distinct updatedAt after erasure. Record known equal-time collision before response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.schema.json#/$defs/ExistingImportConflict"
                }
              }
            }
          },
          "413": {
            "description": "Payload too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "Intake unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.schema.json#/$defs/Error"
                }
              }
            }
          },
          "410": {
            "description": "Expired first import, or equal-time retry after erasure. For an indeterminate comparison, durably record or join the active reconciliation intent before 410.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.schema.json#/$defs/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./types.schema.json#/$defs/Snapshot"
              }
            }
          }
        }
      }
    },
